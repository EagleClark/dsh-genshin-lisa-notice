{
  "name": "dsh-genshin-lisa-notice",
  "description": "每次执行完成或等待用户输入时播放原神·丽莎语音提醒 / A DeepSeek Harness plugin that plays a Genshin Impact Lisa voice alert when an execution completes or the agent asks for your input.",
  "version": "0.2.3",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "homepage": "https://github.com/EagleClark/dsh-genshin-lisa-notice",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "notice",
    "alert",
    "audio",
    "genshin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/EagleClark/dsh-genshin-lisa-notice"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
